# Copy to .env and adjust as needed.
# Defaults match `docker compose up -d db` in the repo root.

DATABASE_URL=postgresql://curator:curator@localhost:5432/curator?schema=public
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Free tier: https://aistudio.google.com/apikey — leave empty to run with the deterministic mock LLM
GEMINI_API_KEY=
LLM_TIMEOUT_MS=20000
