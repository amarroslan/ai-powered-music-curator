{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "corepack pnpm install",
  "buildCommand": "corepack pnpm -r build && corepack pnpm --filter @curator/api build:vercel",
  "outputDirectory": "dist-vercel",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]/index.cjs"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
